# vim:filetype=gitconfig
[user]
  email = {{ .work_email }}
  signingkey = ~/.ssh/id_ecdsa.token2.pub
  # signingkey = ~/.ssh/id_ecdsa.yubikey.pub
  # signingkey = {{ .work_gpg_id }}
[gpg]
  format = ssh
[gpg "ssh"]
  # ~/.ssh/allowed_signers
  # {{ .work_email }} ecdsa-sha2-nistp256 AAA...
  allowedSignersFile = ~/.ssh/allowed_signers
  program = ~/.ssh/piv-ssh-keygen
