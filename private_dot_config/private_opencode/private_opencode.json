{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["bifrost", "openai"],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": { "reasoningEffort": "xhigh" }
        },
        "gpt-5.6-terra": {
          "options": { "reasoningEffort": "xhigh" }
        },
        "gpt-5.6-luna": {}
      }
    },
    "bifrost": {
      "name": "Bifrost",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:9765/v1",
        "apiKey": "{env:BIFROST_VIRTUAL_KEY}",
        "headers": {
          "anthropic-beta": "context-1m-2025-08-07,interleaved-thinking-2025-05-14"
        }
      },
      "models": {
        "agent-plan": {
          "name": "Claude Sonnet 5",
          "cost": {
            "input": 2,
            "output": 10,
            "cache_read": 0.2,
            "cache_write": 2.5
          },
          "limit": { "context": 1000000, "output": 128000 },
          "options": { "reasoningEffort": "high" }
        },
        "agent-build": {
          "name": "Kimi K3",
          "cost": { "input": 3, "output": 15, "cache_read": 0.3 },
          "limit": { "context": 1048576, "output": 131072 },
          "options": { "reasoningEffort": "high" }
        },
        "agent-explore": {
          "name": "DeepSeek V4 Flash 0731 (Bifrost)",
          "cost": { "input": 0.14, "output": 0.28, "cache_read": 0.028 },
          "limit": { "context": 1000000, "output": 384000 },
          "options": { "reasoningEffort": "high" }
        },
        "agent-general": {
          "name": "GLM 5.2 (Bifrost)",
          "cost": { "input": 1.4, "output": 4.4, "cache_read": 0.14 },
          "limit": { "context": 1048575, "output": 131072 },
          "options": { "reasoningEffort": "high" }
        },
        "agent-reviewer": {
          "name": "Gemini 3.1 Pro Preview (Bifrost)",
          "cost": { "input": 2, "output": 12, "cache_read": 0.2 },
          "limit": { "context": 1048576, "output": 65536 },
          "options": { "reasoningEffort": "high" }
        }
      }
    }
  },
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "permission": {
    "*": "ask",

    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "question": "allow",
    "read": "allow",
    "skill": {
      "*": "allow",
      "radio-4-english": "deny"
    },
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",

    "edit": {
      "*": "ask",
      "~/.config/**": "ask"
    },

    // Local MCPs
    "auth0_auth0_get_*": "allow",
    "auth0_auth0_list_*": "allow",

    "google-docs_writeSpreadsheet": "deny",
    "google-docs_batchWrite": "deny",
    "google-docs_appendRows": "deny",
    "google-docs_createSpreadsheet": "deny",
    "google-docs_appendTableRows": "deny",
    "google-docs_download*": "allow",
    "google-docs_get*": "allow",
    "google-docs_list*": "allow",
    "google-docs_read*": "allow",
    "google-docs_search*": "allow",
    "google-docs_triageInbox": "allow",

    "neo4j-cypher_get_*": "allow",
    "neo4j-cypher_read_*": "allow",

    "okta-integrator_get_*": "allow",
    "okta-integrator_list_*": "allow",

    // Remote OAuth MCPs
    "atlassian_atlassianUserInfo": "allow",
    "atlassian_fetch": "allow",
    "atlassian_get*": "allow",
    "atlassian_lookup*": "allow",
    "atlassian_search*": "allow",

    "launchdarkly_get-*": "allow",
    "launchdarkly_list-*": "allow",
    "launchdarkly_find-*": "allow",
    "launchdarkly_search-*": "allow",
    "launchdarkly_query-*": "allow",
    "launchdarkly_check-*": "allow",
    "launchdarkly_match-*": "allow",

    "linear_extract_*": "allow",
    "linear_get_*": "allow",
    "linear_list_*": "allow",
    "linear_search_*": "allow",

    "miro_board_*": "allow",
    "miro_context_*": "allow",
    "miro_diagram_get_dsl": "allow",
    "miro_doc_get": "allow",
    "miro_image_get_*": "allow",
    "miro_table_list_rows": "allow",

    "slack_slack_get_*": "allow",
    "slack_slack_list_*": "allow",
    "slack_slack_read_*": "allow",
    "slack_slack_search_*": "allow",

    "teamcity_teamcity_build_log": "allow",
    "teamcity_teamcity_rest_get": "allow",

    "bash": {
      "*": "ask",

      "cat *": "allow",
      "find *": "allow",
      "find *-delete*": "ask",
      "find *-exec*": "ask",
      "find *-fls*": "ask",
      "find *-fprint*": "ask",
      "find *-ok*": "ask",
      "grep *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "read *": "allow",
      "tail *": "allow",

      "rtk cat*": "allow",
      "rtk find*": "allow",
      "rtk find*-delete*": "ask",
      "rtk find*-exec*": "ask",
      "rtk find*-fls*": "ask",
      "rtk find*-fprint*": "ask",
      "rtk find*-ok*": "ask",
      "rtk grep*": "allow",
      "rtk head*": "allow",
      "rtk ls*": "allow",
      "rtk read *": "allow",
      "rtk tail*": "allow",

      "xargs grep *": "allow",
      "xargs head *": "allow",
      "xargs ls *": "allow",
      "xargs tail *": "allow",

      "git branch": "allow",
      "git branch -a*": "allow",
      "git branch -r*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git show*": "allow",
      "git status*": "allow",
      "git worktree list*": "allow",
      "rtk git branch -a*": "allow",
      "rtk git branch -r*": "allow",
      "rtk git branch": "allow",
      "rtk git diff*": "allow",
      "rtk git log*": "allow",
      "rtk git remote -v": "allow",
      "rtk git remote": "allow",
      "rtk git show*": "allow",
      "rtk git status*": "allow",
      "rtk git worktree list*": "allow",

      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh repo view *": "allow",
      "rtk gh pr list *": "allow",
      "rtk gh pr view *": "allow",
      "rtk gh repo view *": "allow",

      "gh pr create*": "ask",
      "rtk gh pr create*": "ask",

      "uv run mypy *": "allow",
      "uv run pytest *": "allow",
      "uv run ruff *": "allow",
      "rtk uv run mypy *": "allow",
      "rtk uv run pytest *": "allow",
      "rtk uv run ruff *": "allow",

      "pnpm test*": "allow",
      "pnpm list*": "allow",
      "pnpm ls*": "allow",
      "pnpm info *": "allow",
      "pnpm outdated*": "allow",
      "pnpm why *": "allow",
      "rtk pnpm test*": "allow",
      "rtk pnpm list*": "allow",
      "rtk pnpm ls*": "allow",
      "rtk pnpm info *": "allow",
      "rtk pnpm outdated*": "allow",
      "rtk pnpm why *": "allow",

      "npm test*": "allow",
      "npm list*": "allow",
      "npm ls*": "allow",
      "npm info *": "allow",
      "npm outdated*": "allow",
      "npm why *": "allow",
      "rtk npm test*": "allow",
      "rtk npm list*": "allow",
      "rtk npm ls*": "allow",
      "rtk npm info *": "allow",
      "rtk npm outdated*": "allow",
      "rtk npm why *": "allow",

      "chezmoi *": "ask",
      "rtk chezmoi *": "ask"
    }
  },
  "default_agent": "plan",
  "agent": {
    "plan": {
      "color": "#57c7ff",
      "model": "bifrost/agent-build",
      "permission": {
        "skill": {
          "radio-4-english": "allow"
        }
      }
    },
    "build": {
      "color": "#ff6ac1",
      "model": "bifrost/agent-build",
      "permission": {
        "skill": {
          "radio-4-english": "allow"
        }
      }
    },
    "general": {
      "color": "#5af78e",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "permission": {
        "task": "deny"
      },
      "prompt": "{file:./GENERAL.md}"
    },
    "explore": {
      "color": "#f3f99d",
      "mode": "subagent",
      "model": "bifrost/agent-explore",
      "permission": {
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "{file:./EXPLORE.md}"
    },
    "reviewer": {
      "color": "#ff5c57",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "permission": {
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "{file:./REVIEWER.md}"
    },
    "compaction": {
      "model": "bifrost/agent-general"
    }
  },
  "plugin": [
    "superpowers@git+https://github.com/ethan605/superpowers.git#a1479fc98f35f023e0862bb5e09d4115ba4d8d8a"
  ],
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "basedpyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    }
  },
  "mcp": {
    "atlassian": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "oauth": {}
    },
    "auth0": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "@auth0/auth0-mcp-server", "run"],
      "environment": {
        "DEBUG": "auth0-mcp"
      }
    },
    "google-docs": {
      "enabled": true,
      "type": "local",
      "command": ["npx", "-y", "@a-bonus/google-docs-mcp"],
      "environment": {
        "GOOGLE_CLIENT_ID": "{env:GOOGLE_DOCS_MCP_CLIENT_ID}",
        "GOOGLE_CLIENT_SECRET": "{env:GOOGLE_DOCS_MCP_CLIENT_SECRET}"
      }
    },
    "grafana": {
      "enabled": false,
      "type": "local",
      "command": ["uvx", "mcp-grafana"],
      "environment": {
        "GRAFANA_URL": "{env:GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      }
    },
    "launchdarkly": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.launchdarkly.com/mcp/launchdarkly",
      "oauth": {}
    },
    "linear": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "oauth": {}
    },
    "miro": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.miro.com",
      "oauth": {}
    },
    "neo4j-cypher": {
      "enabled": false,
      "type": "local",
      "command": ["uvx", "mcp-neo4j-cypher", "--transport", "stdio"],
      "environment": {
        "NEO4J_URI": "{env:NEO4J_URI}",
        "NEO4J_USERNAME": "{env:NEO4J_USERNAME}",
        "NEO4J_PASSWORD": "{env:NEO4J_PASSWORD}",
        "NEO4J_DATABASE": "{env:NEO4J_DATABASE}"
      }
    },
    "okta-integrator": {
      "enabled": false,
      "type": "local",
      "command": ["uvx", "okta-mcp-server"],
      "timeout": 60000,
      "environment": {
        "OKTA_ORG_URL": "{env:OKTA_ORG_URL}",
        "OKTA_CLIENT_ID": "{env:OKTA_CLIENT_ID}",
        "OKTA_SCOPES": "{env:OKTA_SCOPES}",
        "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"
      }
    },
    "postgresql": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@bytebase/dbhub",
        "--transport",
        "stdio",
        "--dsn",
        "{env:POSTGRES_CONNECTION_STRING}"
      ]
    },
    "slack": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "redirectUri": "http://localhost:3118/callback"
      }
    },
    "teamcity": {
      "enabled": true,
      "type": "remote",
      "url": "https://live.neo4j-build.io/app/mcp",
      "headers": {
        "Authorization": "Bearer {env:TC_AUTH_TOKEN}"
      }
    }
  }
}
