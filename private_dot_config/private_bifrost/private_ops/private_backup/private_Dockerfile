FROM alpine:3.24.1

RUN apk update \
  && apk add --no-cache \
    sqlite=3.53.2-r0 \
    tzdata=2026c-r0 \
    util-linux=2.42.1-r0 \
  && apk upgrade \
  && rm -rf /var/cache/apk/*

LABEL maintainer=xtnguyen605@gmail.com

COPY backup-entrypoint.sh /usr/local/bin/backup-entrypoint
COPY backup-logs-db.sh /usr/local/bin/backup-logs-db

RUN chmod 0555 /usr/local/bin/backup-entrypoint /usr/local/bin/backup-logs-db

ENTRYPOINT ["/usr/local/bin/backup-entrypoint"]
