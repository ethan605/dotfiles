    "budgets": [
      {
        "id": "9bf44a97-743c-47ec-9897-01af22fa3659",
        "max_limit": 25,
        "reset_duration": "1w",
        "model_config_id": "d5559976-f181-450b-829c-55f6d39c5d4c"
      },
      {
        "id": "e37c3d68-b442-47a6-a4a5-fef2047c3d82",
