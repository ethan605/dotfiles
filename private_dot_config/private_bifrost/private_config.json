{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": { "enforce_auth_on_inference": true },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/Users/thanh/.config/bifrost/config.db"
    }
  },
  "providers": {
    "fireworks": {
      "network_config": {
        "max_retries": 3,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      }
    },
    "anthropic": {
      "network_config": {
        "max_retries": 3,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      }
    }
  },
  "governance": {
    "routing_rules": [
      {
        "id": "fb-fireworks-kimi-to-glm",
        "name": "Kimi K3 -> GLM 5p2 on failure",
        "description": "Same-provider failover for the build agent's model",
        "enabled": true,
        "cel_expression": "model == 'accounts/fireworks/models/kimi-k3'",
        "targets": [{ "provider": "fireworks", "weight": 1.0 }],
        "fallbacks": ["fireworks/accounts/fireworks/models/glm-5p2"],
        "scope": "global",
        "priority": 0
      },
      {
        "id": "fb-fireworks-glm-to-kimi",
        "name": "GLM 5p2 -> Kimi K3 on failure",
        "description": "Same-provider failover for general/compaction agents' model",
        "enabled": true,
        "cel_expression": "model == 'accounts/fireworks/models/glm-5p2'",
        "targets": [{ "provider": "fireworks", "weight": 1.0 }],
        "fallbacks": ["fireworks/accounts/fireworks/models/kimi-k3"],
        "scope": "global",
        "priority": 1
      },
      {
        "id": "fb-fireworks-deepseek-to-glm",
        "name": "DeepSeek V4 Flash -> GLM 5p2 on failure",
        "description": "Same-provider failover for the explore agent's model",
        "enabled": true,
        "cel_expression": "model == 'accounts/fireworks/models/deepseek-v4-flash'",
        "targets": [{ "provider": "fireworks", "weight": 1.0 }],
        "fallbacks": ["fireworks/accounts/fireworks/models/glm-5p2"],
        "scope": "global",
        "priority": 2
      },
      {
        "id": "fb-anthropic-claude-to-kimi",
        "name": "Claude Opus 4.8 -> Kimi K3 on failure",
        "description": "Cross-provider failover for the plan agent (user-approved)",
        "enabled": true,
        "cel_expression": "model == 'claude-opus-4-8'",
        "targets": [{ "provider": "anthropic", "weight": 1.0 }],
        "fallbacks": ["fireworks/accounts/fireworks/models/kimi-k3"],
        "scope": "global",
        "priority": 3
      }
    ]
  }
}
