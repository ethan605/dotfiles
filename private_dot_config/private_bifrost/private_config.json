{
  "$schema": "https://www.getbifrost.ai/schema",
  "source_of_truth": "config.json",
  "client": { "enforce_auth_on_inference": true },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/Users/thanh/.config/bifrost/config.db"
    }
  },
  "providers": {
    "anthropic": {
      "keys": [
        {
          "name": "claude-platform",
          "value": "env.ANTHROPIC_API_KEY",
          "models": ["claude-opus-5", "claude-opus-4-8", "claude-sonnet-5"],
          "blacklisted_models": ["claude-fable-5"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "max_retries": 3,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      }
    },
    "fireworks": {
      "keys": [
        {
          "name": "fireworks-ai",
          "value": "env.FIREWORKS_API_KEY",
          "models": [
            "accounts/fireworks/models/kimi-k3",
            "accounts/fireworks/models/glm-5p2",
            "accounts/fireworks/models/deepseek-v4-flash"
          ],
          "blacklisted_models": [
            "accounts/fireworks/routers/kimi-k3-fast",
            "accounts/fireworks/routers/glm-5p2-fast"
          ],
          "weight": 1.0
        }
      ],
      "network_config": {
        "max_retries": 3,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      }
    }
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "cbf31912-4166-4d2f-b6e9-f078c46850a6",
        "name": "opencode-host",
        "description": "OpenCode in Host",
        "value": "env.BIFROST_VK_OPENCODE_HOST",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "anthropic",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          },
          {
            "provider": "fireworks",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          }
        ]
      },
      {
        "id": "cd5069d7-8900-4ad1-8831-8b5513b6d40b",
        "name": "opencode-devpod",
        "description": "OpenCode in devpod",
        "value": "env.BIFROST_VK_OPENCODE_DEVPOD",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "anthropic",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          },
          {
            "provider": "fireworks",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          }
        ]
      }
    ],
    "model_configs": [
