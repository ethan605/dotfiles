{
  "$schema": "https://www.getbifrost.ai/schema",
  "source_of_truth": "split",
  "client": { "enforce_auth_on_inference": true },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/config.db"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/logs.db"
    }
  },
  "vector_store": {
    "enabled": true,
    "type": "redis",
    "config": {
      "addr": "valkey:6379",
      "db": 0,
      "use_tls": false,
      "cluster_mode": false
    }
  },
  "plugins": [
    {
      "enabled": true,
      "name": "semantic_cache",
      "config": {
        "dimension": 1,
        "ttl": "24h",
        "default_cache_key": "opencode",
        "conversation_history_threshold": 50,
        "vector_store_namespace": "OpenCodeSemanticCache"
      }
    }
  ],
  "providers": {
    "anthropic": {
      "keys": [
        {
          "name": "claude-platform",
          "value": "env.ANTHROPIC_API_KEY",
          "models": ["claude-sonnet-5", "claude-opus-4-8"],
          "blacklisted_models": ["claude-fable-5", "claude-opus-5"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "max_retries": 3,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      }
    },
    "fireworks": {
      "keys": [
        {
          "name": "fireworks-ai",
          "value": "env.FIREWORKS_API_KEY",
          "models": [
            "accounts/fireworks/models/kimi-k3",
            "accounts/fireworks/models/glm-5p2",
            "accounts/fireworks/models/deepseek-v4-flash-0731"
          ],
          "aliases": {
            "kimi-k3": "accounts/fireworks/models/kimi-k3",
            "glm-5p2": "accounts/fireworks/models/glm-5p2",
            "deepseek-flash-v4-0731": "accounts/fireworks/models/deepseek-flash-v4-0731"
          },
          "blacklisted_models": [
            "accounts/fireworks/routers/kimi-k3-fast",
            "accounts/fireworks/routers/glm-5p2-fast",
            "accounts/fireworks/models/deepseek-v4-flash"
          ],
          "weight": 1.0
        }
      ],
      "network_config": {
        "max_retries": 3,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      }
    }
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "cbf31912-4166-4d2f-b6e9-f078c46850a6",
        "name": "opencode-host",
        "description": "OpenCode in Host",
        "value": "env.BIFROST_VK_OPENCODE_HOST",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "anthropic",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          },
          {
            "provider": "fireworks",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          }
        ]
      },
      {
        "id": "cd5069d7-8900-4ad1-8831-8b5513b6d40b",
        "name": "opencode-devpod",
        "description": "OpenCode in devpod",
        "value": "env.BIFROST_VK_OPENCODE_DEVPOD",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "anthropic",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          },
          {
            "provider": "fireworks",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1
          }
        ]
      }
    ],
    "model_configs": [
      {
        "id": "d5559976-f181-450b-829c-55f6d39c5d4c",
        "model_name": "*",
        "provider": "anthropic",
        "scope": "virtual_key",
        "scope_id": "cbf31912-4166-4d2f-b6e9-f078c46850a6",
        "budget_id": "9bf44a97-743c-47ec-9897-01af22fa3659"
      },
      {
        "id": "dc6f568c-d646-4d78-8dcc-13d29fc53141",
        "model_name": "*",
        "provider": "fireworks",
        "scope": "virtual_key",
        "scope_id": "cbf31912-4166-4d2f-b6e9-f078c46850a6",
        "budget_id": "e37c3d68-b442-47a6-a4a5-fef2047c3d82"
      },
      {
        "id": "37214044-8ce6-47b4-bded-d64efb275e0a",
        "model_name": "*",
        "provider": "anthropic",
        "scope": "virtual_key",
        "scope_id": "cd5069d7-8900-4ad1-8831-8b5513b6d40b",
        "budget_id": "a16ab5c0-50ee-47e4-bfc4-55ecd5651afd"
      },
      {
        "id": "2d4ff892-9012-46fb-978c-139f78331ee1",
        "model_name": "*",
        "provider": "fireworks",
        "scope": "virtual_key",
        "scope_id": "cd5069d7-8900-4ad1-8831-8b5513b6d40b",
        "budget_id": "33af11f2-cd9e-4f44-8c11-e53a7ac07910"
      }
    ],
    "budgets": [
      {
        "id": "9bf44a97-743c-47ec-9897-01af22fa3659",
        "max_limit": 25,
        "reset_duration": "1w",
        "model_config_id": "d5559976-f181-450b-829c-55f6d39c5d4c"
      },
      {
        "id": "e37c3d68-b442-47a6-a4a5-fef2047c3d82",
        "max_limit": 25,
        "reset_duration": "1w",
        "model_config_id": "dc6f568c-d646-4d78-8dcc-13d29fc53141"
      },
      {
        "id": "a16ab5c0-50ee-47e4-bfc4-55ecd5651afd",
        "max_limit": 80,
        "reset_duration": "1w",
        "model_config_id": "37214044-8ce6-47b4-bded-d64efb275e0a"
      },
      {
        "id": "33af11f2-cd9e-4f44-8c11-e53a7ac07910",
        "max_limit": 80,
        "reset_duration": "1w",
        "model_config_id": "2d4ff892-9012-46fb-978c-139f78331ee1"
      }
    ],
    "routing_rules": [
      {
        "id": "alias-agent-plan",
        "name": "Alias: agent-plan -> Claude Sonnet 5",
        "description": "Route the plan agent's alias to Anthropic Claude Sonnet 5",
        "enabled": true,
        "cel_expression": "model == 'agent-plan'",
        "targets": [
          { "provider": "anthropic", "model": "claude-sonnet-5", "weight": 1.0 }
        ],
        "fallbacks": ["fireworks/accounts/fireworks/models/kimi-k3"],
        "scope": "global",
        "priority": 0
      },
      {
        "id": "alias-agent-build",
        "name": "Alias: agent-build -> Kimi K3",
        "description": "Route the build agent's alias to Fireworks Kimi K3",
        "enabled": true,
        "cel_expression": "model == 'agent-build'",
        "targets": [
          {
            "provider": "fireworks",
            "model": "accounts/fireworks/models/kimi-k3",
            "weight": 1.0
          }
        ],
        "fallbacks": ["fireworks/accounts/fireworks/models/glm-5p2"],
        "scope": "global",
        "priority": 1
      },
      {
        "id": "alias-agent-explore",
        "name": "Alias: agent-explore -> DeepSeek V4 Flash",
        "description": "Route the explore agent's alias to Fireworks DeepSeek V4 Flash",
        "enabled": true,
        "cel_expression": "model == 'agent-explore'",
        "targets": [
          {
            "provider": "fireworks",
            "model": "accounts/fireworks/models/deepseek-v4-flash-0731",
            "weight": 1.0
          }
        ],
        "fallbacks": ["fireworks/accounts/fireworks/models/glm-5p2"],
        "scope": "global",
        "priority": 2
      },
      {
        "id": "alias-agent-general",
        "name": "Alias: agent-general -> GLM 5p2",
        "description": "Route the general/compaction agents' alias to Fireworks GLM 5p2",
        "enabled": true,
        "cel_expression": "model == 'agent-general'",
        "targets": [
          {
            "provider": "fireworks",
            "model": "accounts/fireworks/models/glm-5p2",
            "weight": 1.0
          }
        ],
        "fallbacks": ["fireworks/accounts/fireworks/models/kimi-k3"],
        "scope": "global",
        "priority": 3
      }
    ]
  },
  "mcp": {
    "tool_manager_config": {
      "disable_auto_tool_inject": true
    },
    "client_configs": [
      {
        "name": "linear",
        "client_id": "36847e00-1aaa-40b6-bbe5-f1d02f91c346",
        "connection_type": "http",
        "connection_string": "https://mcp.linear.app/mcp",
        "auth_type": "oauth",
        "oauth_config_id": "e5842786-9fe8-417a-9b38-435f08b0282a",
        "tools_to_execute": ["*"],
        "is_ping_available": true,
        "allow_on_all_virtual_keys": true
      },
      {
        "name": "miro",
        "client_id": "51090700-49e2-4f12-a18f-cb3b7049619c",
        "connection_type": "http",
        "connection_string": "https://mcp.miro.com",
        "auth_type": "oauth",
        "oauth_config_id": "5702f661-f63f-400c-bf4a-6c7ea33a2d66",
        "tools_to_execute": ["*"],
        "is_ping_available": true,
        "allow_on_all_virtual_keys": true
      },
      {
        "name": "rovo",
        "client_id": "2baed050-dc5c-4139-a39b-195e2c4955e5",
        "connection_type": "http",
        "connection_string": "https://mcp.atlassian.com/v1/mcp/authv2",
        "auth_type": "oauth",
        "oauth_config_id": "8da8170e-394b-416f-9420-f7cebf7fb6c8",
        "tools_to_execute": ["*"],
        "is_ping_available": true,
        "allow_on_all_virtual_keys": true
      },
      {
        "name": "teamcity",
        "connection_type": "http",
        "connection_string": "https://live.neo4j-build.io/app/mcp",
        "auth_type": "headers",
        "headers": { "Authorization": "env.TEAMCITY_MCP_AUTH" },
        "tools_to_execute": ["*"],
        "is_ping_available": true,
        "allow_on_all_virtual_keys": true
      }
    ]
  }
}
